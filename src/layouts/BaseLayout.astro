---
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import LanguageBanner from '../components/LanguageBanner.astro';
import { ui, type Lang, type UIKey } from '../i18n/ui';
import { getAlternates } from '../i18n/utils';
import '../styles/global.css';
import '../components/prototype/visuals.css';
import '../components/prototype/screens.css';
import '../components/prototype/controls.css';

interface Props {
	lang: Lang;
	titleKey: UIKey;
	descriptionKey: UIKey;
}

const { lang, titleKey, descriptionKey } = Astro.props;
const t = (key: UIKey) => ui[lang][key];

const siteOrigin = Astro.site ? Astro.site.origin : 'https://simulacro.tech';
const alternates = getAlternates(Astro.url.pathname, siteOrigin);

// Build date — used in the footer caption. Set at build time.
const buildDate = new Date().toISOString().slice(0, 10);
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={t(descriptionKey)} />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/png" href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/simulacro.png`} />
		{alternates.map((alt) => (
			<link rel="alternate" hreflang={alt.hreflang} href={alt.href} />
		))}
		<title>{t(titleKey)}</title>
	</head>
	<body class:list={["overflow-x-hidden", { "design-study": import.meta.env.DEV }]} data-variant={import.meta.env.DEV ? "A" : undefined} data-build-date={buildDate}>
		<!-- Animated network canvas -->
		<canvas id="network-canvas" class="fixed inset-0 pointer-events-none z-0"></canvas>

		<div class="min-h-screen flex flex-col relative z-10">
			<Navigation lang={lang} />
			<main class="flex-grow relative">
				<slot />
			</main>
			<Footer lang={lang} buildDate={buildDate} />
		</div>

		<LanguageBanner lang={lang} />

		<script>
			import { startConstellation } from '../scripts/constellation';
			startConstellation(document.querySelector<HTMLCanvasElement>('#network-canvas')!);
		</script>

		<script>
			// Scroll reveal animation — staggered children inside revealed sections
			const revealObserver = new IntersectionObserver((entries) => {
				entries.forEach(entry => {
					if (entry.isIntersecting) {
						entry.target.classList.add('revealed');
					}
				});
			}, {
				threshold: 0.12,
				rootMargin: '0px 0px -60px 0px'
			});

			// Observe all sections for reveal
			document.querySelectorAll('section').forEach(el => {
				el.classList.add('reveal-on-scroll');
				revealObserver.observe(el);
			});

			// Also observe elements that opt in directly
			document.querySelectorAll('.reveal-on-scroll').forEach(el => {
				revealObserver.observe(el);
			});
		</script>
	</body>
</html>
