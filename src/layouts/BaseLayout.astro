---
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import LanguageBanner from '../components/LanguageBanner.astro';
import { ui, type Lang, type UIKey } from '../i18n/ui';
import { getAlternates } from '../i18n/utils';
import '../styles/global.css';

interface Props { lang: Lang; titleKey: UIKey; descriptionKey: UIKey; }
const { lang, titleKey, descriptionKey } = Astro.props;
const t = (key: UIKey) => ui[lang][key];
const siteOrigin = Astro.site?.origin || 'https://simulacro.tech';
const alternates = getAlternates(Astro.url.pathname, siteOrigin);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={t(descriptionKey)} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href={base + '/simulacro.png'} />
    <link rel="preload" href={base + '/fonts/archivo-latin.woff2'} as="font" type="font/woff2" crossorigin />
    <link rel="canonical" href={new URL(Astro.url.pathname, siteOrigin)} />
    {alternates.map(alt => <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />)}
    <meta property="og:title" content={t(titleKey)} />
    <meta property="og:description" content={t(descriptionKey)} />
    <meta property="og:image" content={siteOrigin + base + '/simulacro.png'} />
    <meta property="og:type" content="website" />
    <title>{t(titleKey)}</title>
  </head>
  <body>
    <!-- An interdisciplinary consultancy, led by its actual work.
         Archivo typography, amber actions, open project layouts, original artwork.
         Content stays visible at rest; navigation and reading need no animation. -->
    <a class="skip-link" href="#main-content">{t('nav.skip')}</a>
    <Navigation lang={lang} />
    <main id="main-content" tabindex="-1"><slot /></main>
    <Footer lang={lang} />
    <LanguageBanner lang={lang} />
  </body>
</html>
