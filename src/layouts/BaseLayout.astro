---
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import LanguageBanner from '../components/LanguageBanner.astro';
import { ui, type Lang, type UIKey } from '../i18n/ui';
import { getAlternates } from '../i18n/utils';
import { markdownPath } from '../lib/markdown-routes.mjs';
import '../styles/global.css';
import '../styles/site/home.css';
import '../styles/site/atmosphere.css';
import '../styles/site/motion.css';
import '../styles/site/home-projects.css';
import '../styles/site/visuals.css';
import '../styles/site/screens.css';
import '../styles/site/project-grid.css';
import '../styles/site/controls.css';
import '../styles/site/micro-motion.css';

interface Props {
	lang: Lang;
	titleKey: UIKey;
	descriptionKey: UIKey;
  home?: boolean;
}

const { lang, titleKey, descriptionKey, home = false } = Astro.props;
const t = (key: UIKey) => ui[lang][key];

const siteOrigin = Astro.site ? Astro.site.origin : 'https://simulacro.tech';
const alternates = getAlternates(Astro.url.pathname, siteOrigin);

// Build date retained as document metadata.
const buildDate = new Date().toISOString().slice(0, 10);
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="UTF-8" />
		<meta name="color-scheme" content="dark" />
		<meta name="description" content={t(descriptionKey)} />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/png" href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/simulacro.png`} />
		{alternates.map((alt) => (
			<link rel="alternate" hreflang={alt.hreflang} href={alt.href} />
		))}
		<link rel="alternate" type="text/markdown" href={markdownPath(Astro.url.pathname)} />
		<title>{t(titleKey)}</title>
	</head>
	<body class:list={["overflow-x-hidden site-design", { "home-design": home }]} data-build-date={buildDate}>
		<!-- Animated network canvas -->
		<canvas aria-hidden="true" id="network-canvas" class="fixed inset-0 pointer-events-none z-0"></canvas>

		<div class="min-h-screen flex flex-col relative z-10">
			<Navigation lang={lang} />
			<main id="content" class="flex-grow relative">
				<slot />
			</main>
			<Footer lang={lang} />
		</div>

		<LanguageBanner lang={lang} />

		<script>
			import { startConstellation } from '../scripts/constellation';
			startConstellation(document.querySelector<HTMLCanvasElement>('#network-canvas')!);
		</script>

		<script>
			const revealObserver = new IntersectionObserver((entries) => {
				entries.forEach(entry => {
					if (entry.isIntersecting) {
						entry.target.classList.add('revealed');
						revealObserver.unobserve(entry.target);
					}
				});
			}, {
				threshold: 0.12,
				rootMargin: '0px 0px -60px 0px'
			});

			const revealTargets = '.project-identity h3, .project-identity > a, .project-description, .about-bio p, .about-history h2, .about-history .space-y-7 > div';
      document.querySelectorAll(`${revealTargets}, .reveal-on-scroll`).forEach(el => {
        el.classList.add('reveal-on-scroll');
        revealObserver.observe(el);
      });
		</script>
	</body>
</html>
