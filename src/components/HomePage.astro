---
import { ArrowRight } from 'lucide-astro';
import WorkVisual from './illustrations/WorkVisual.astro';
import ContactForm from './ContactForm.astro';
import { featuredProjects } from '../data/featuredProjects';
import { ui, type Lang } from '../i18n/ui';
import { getLocalizedPath } from '../i18n/utils';
interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = ui[lang];
const services = ['ai', 'data', 'pipelines'] as const;
const disciplines = ['clinical', 'philosophy', 'technical'] as const;
---
    <div class="home-page">
      <section class="intro">
        <div class="hero-art" aria-hidden="true"><WorkVisual kind="hero" /></div>
        <h1>{t['home.hero.title.before']} <span>{t['home.hero.title.highlight']}</span></h1>
        <div class="intro-detail">
          <p>{t['home.hero.tagline']}</p>
          <a class="contact-link" href="#contact">{t['home.hero.cta']} <ArrowRight size={18} /></a>
        </div>
      </section>
      <section class="services" aria-labelledby="services-heading">
        <div class="section-heading"><h2 id="services-heading">{t['home.services.heading']}</h2><p>{t['home.services.subheading']}</p></div>
        <div class="service-list">
          {services.map(service => <article id={`service-${service}`}>
            <h3>{t[`home.services.${service}.title`]}</h3>
            <WorkVisual kind={service} />
            <p>{t[`home.services.${service}.description`]}</p>
          </article>)}
        </div>
      </section>
      <section id="projects" class="projects" aria-labelledby="projects-heading">
        <div class="section-heading"><h2 id="projects-heading">{t['home.projects.heading']}</h2><p>{t['home.projects.intro']}</p></div>
        <div class="project-list">
          {featuredProjects.map(project => <a class="project" href={'href' in project ? project.href : `${getLocalizedPath("/projects", lang)}#${project.id}`}>
            <WorkVisual kind={project.id} />
            <div class="project-copy"><h3>{project.name}</h3><p>{t[project.taglineKey]}</p></div>
            <ArrowRight size={22} aria-hidden="true" />
          </a>)}
        </div>
        <a class="text-link" href={getLocalizedPath("/projects", lang)}>{t['home.projects.cta']} <ArrowRight size={16} /></a>
      </section>
      <section class="background" aria-labelledby="background-heading">
        <div class="section-heading"><h2 id="background-heading">{t['home.why.heading']}</h2><p>{t['home.why.intro']}</p></div>
        <div class="discipline-list">
          {disciplines.map(discipline => <article><h3>{t[`home.why.${discipline}.title`]}</h3><p>{t[`home.why.${discipline}.description`]}</p></article>)}
        </div>
        <div class="bio"><p>{t['home.about.bio']}</p><a class="text-link" href={getLocalizedPath("/about", lang)}>{t['home.about.cta']} <ArrowRight size={16} /></a></div>
      </section>
      <section id="contact" class="contact" aria-labelledby="contact-heading">
        <div><h2 id="contact-heading">{t['home.contact.heading']}</h2><a class="text-link" href="mailto:contact@simulacro.tech">contact@simulacro.tech</a></div>
        <ContactForm lang={lang} />
      </section>
    </div>

<script>
        const textObserver = new IntersectionObserver(entries => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.classList.add('text-arrived');
              textObserver.unobserve(entry.target);
            }
          }
        }, { threshold: .15 });
        document.querySelectorAll('.section-heading, .service-list h3, .service-list p, .project-copy, .discipline-list article, .bio, .contact > div, .contact form').forEach(element => textObserver.observe(element));

</script>
