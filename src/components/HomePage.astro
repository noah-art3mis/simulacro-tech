---
import { ArrowRight, ArrowUpRight } from 'lucide-astro';
import ContactForm from './ContactForm.astro';
import ProjectStats from './ProjectStats.astro';
import { production, openSource } from '../data/projects';
import { ui, type Lang, type UIKey } from '../i18n/ui';
import { getLocalizedPath } from '../i18n/utils';
import '../styles/home.css';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = (key: UIKey) => ui[lang][key];
const aboutHref = getLocalizedPath('/about', lang);
const projectsHref = getLocalizedPath('/projects', lang);
const featured = production[0];
const otherProjects = [production[1], production[3], openSource[0]];
const services = ['ai', 'data', 'pipelines'] as const;
const approaches = ['clinical', 'philosophy', 'technical'] as const;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<section class="home-hero shell">
  <div class="hero-copy">
    <h1>{t('home.hero.title')}</h1>
    <p>{t('home.hero.tagline')}</p>
    <a class="btn-primary" href="#contact">{t('home.hero.cta')} <ArrowUpRight size={19} /></a>
  </div>
  <figure class="hero-art">
    <img src={base + '/simulacro.png'} width="950" height="950" alt="" fetchpriority="high" />
  </figure>
</section>

<section id="projects" class="home-projects shell" aria-labelledby="projects-heading">
  <div class="section-top">
    <h2 id="projects-heading">{t('home.projects.heading')}</h2>
    <a class="text-link" href={projectsHref}>{t('home.projects.cta')} <ArrowRight size={18} /></a>
  </div>
  <article class="featured-project">
    <div class="featured-description">
      <a class="project-title" href={projectsHref + '#' + featured.id}><h3>{featured.name}</h3><ArrowUpRight size={30} /></a>
      <p>{t('projects.production.molcajete.tagline')}</p>
    </div>
    <ProjectStats project={featured} lang={lang} />
  </article>
  <div class="home-project-list">
    {otherProjects.map(project => (
      <article>
        <a class="project-title" href={projectsHref + '#' + project.id}><h3>{project.name}</h3><ArrowUpRight size={22} /></a>
        <p>{t(('projects.' + project.kind + '.' + project.id + '.tagline') as UIKey)}</p>
      </article>
    ))}
  </div>
</section>

<section id="services" class="services shell" aria-labelledby="services-heading">
  <div class="services-intro">
    <h2 id="services-heading">{t('home.services.heading')}</h2>
    <p>{t('home.services.subheading')}</p>
  </div>
  <div class="service-list">
    {services.map(service => (
      <article>
        <h3>{t(('home.services.' + service + '.title') as UIKey)}</h3>
        <p>{t(('home.services.' + service + '.description') as UIKey)}</p>
      </article>
    ))}
  </div>
</section>

<section class="approach shell" aria-labelledby="approach-heading">
  <div class="approach-intro">
    <h2 id="approach-heading">{t('home.why.heading')}</h2>
    <p>{t('home.why.intro')}</p>
    <div class="founder-note">
      <p>{t('home.about.bio')}</p>
      <a class="text-link" href={aboutHref}>{t('home.about.cta')} <ArrowRight size={18} /></a>
    </div>
  </div>
  <div class="approach-list">
    {approaches.map(approach => (
      <article>
        <h3>{t(('home.why.' + approach + '.title') as UIKey)}</h3>
        <p>{t(('home.why.' + approach + '.description') as UIKey)}</p>
      </article>
    ))}
  </div>
</section>

<section id="contact" class="contact-section shell" aria-labelledby="contact-heading">
  <div class="contact-intro">
    <h2 id="contact-heading">{t('home.contact.heading')}</h2>
    <a class="text-link contact-email" href="mailto:contact@simulacro.tech">contact@simulacro.tech <ArrowUpRight size={21} /></a>
  </div>
  <ContactForm lang={lang} />
</section>
