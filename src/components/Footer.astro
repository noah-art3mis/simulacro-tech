---
import { ui, type Lang, type UIKey } from '../i18n/ui';
import { getLocalizedPath } from '../i18n/utils';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = (key: UIKey) => ui[lang][key];
const year = new Date().getFullYear();
---
<footer class="site-footer shell">
  <div class="footer-brand">
    <a class="wordmark" href={getLocalizedPath('/', lang)}>simulacro<span>.tech</span></a>
    <p>{t('footer.tagline')}</p>
  </div>
  <div class="footer-contact">
    <h2>{t('footer.contact.heading')}</h2>
    <a href="mailto:contact@simulacro.tech">contact@simulacro.tech</a>
    <a href="tel:+5561981334405">+55 61 98133-4405</a>
    <p>{t('footer.contact.location')}</p>
  </div>
  <nav class="footer-links" aria-label={t('footer.connect.heading')}>
    <a href="https://linkedin.com/in/gustavoarcos">LinkedIn</a>
    <a href="https://github.com/noah-art3mis">GitHub</a>
    <a href="https://simulacro.cv">{t('about.links.cv')}</a>
    <a href="https://simulacro.co.uk">{t('about.links.essays')}</a>
    <a href="https://gustavocosta.psc.br">{t('about.links.philosophy')}</a>
  </nav>
  <p class="copyright">&copy; {year} Simulacro Tech. {t('footer.copyright')}</p>
</footer>
