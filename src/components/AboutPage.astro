---
import { ArrowUpRight } from 'lucide-astro';
import { ui, type Lang, type UIKey } from '../i18n/ui';
import '../styles/about.css';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = (key: UIKey) => ui[lang][key];
const links = [
  { key: 'cv', href: 'https://simulacro.cv' },
  { key: 'essays', href: 'https://simulacro.co.uk' },
  { key: 'philosophy', href: 'https://gustavocosta.psc.br' },
] as const;
const education = [
  { key: 'degree1', school: 'London Interdisciplinary School' },
  { key: 'degree2', school: 'Faculdade Inspirar' },
  { key: 'degree3', school: 'Universidade de Brasília' },
] as const;
const experience = ['leadEngineer', 'research', 'psychotherapy', 'writing'] as const;
---
<section class="page-heading shell">
  <h1>Gustavo Costa</h1>
  <p>{t('about.subtitle')}</p>
</section>

<section class="about-bio shell">
  <div class="biography">
    <p>{t('about.bio.p1')}</p>
    <p>{t('about.bio.p2')}</p>
    <p>{t('about.bio.p3')}</p>
  </div>
  <aside class="about-links">
    <h2>{t('about.links.heading')}</h2>
    {links.map(link => (
      <a class="text-link" href={link.href} target="_blank" rel="noopener noreferrer">
        {t(('about.links.' + link.key) as UIKey)} <ArrowUpRight size={18} />
      </a>
    ))}
  </aside>
</section>

<div class="about-background shell">
  <section aria-labelledby="education-heading">
    <h2 id="education-heading">{t('about.education.heading')}</h2>
    <div class="background-entries">
      {education.map(degree => (
        <article>
          <h3>{t(('about.education.' + degree.key + '.title') as UIKey)}</h3>
          <p>{degree.school}</p>
        </article>
      ))}
    </div>
  </section>
  <section aria-labelledby="experience-heading">
    <h2 id="experience-heading">{t('about.experience.heading')}</h2>
    <div class="background-entries">
      {experience.map(role => (
        <article>
          <h3>{t(('about.experience.' + role + '.title') as UIKey)}</h3>
          <p>{t(('about.experience.' + role + '.details') as UIKey)}</p>
          <p class="entry-dates">{t(('about.experience.' + role + '.dates') as UIKey)}</p>
        </article>
      ))}
    </div>
  </section>
</div>
