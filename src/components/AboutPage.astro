---
import '../styles/site/about-reading.css';
import { ArrowUpRight } from 'lucide-astro';
import { ui, type Lang, type UIKey } from '../i18n/ui';
interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = (key: UIKey) => ui[lang][key];
const links = [
  { href: 'https://linkedin.com/in/gustavoarcos', label: 'LinkedIn' },
  { href: 'https://github.com/noah-art3mis', label: 'GitHub' },
  { href: 'https://simulacro.cv', label: t('about.links.cv') },
  { href: 'https://simulacro.co.uk', label: t('about.links.essays') },
  { href: 'https://gustavocosta.psc.br', label: t('about.links.philosophy') },
];
const education = [
  { title: t('about.education.degree1.title'), place: 'London Interdisciplinary School' },
  { title: t('about.education.degree2.title'), place: 'Faculdade Inspirar' },
  { title: t('about.education.degree3.title'), place: 'Universidade de Brasília' },
];
const experience = ['leadEngineer', 'research', 'psychotherapy', 'writing'] as const;
---
<section class="reading-intro">
  <h1>Gustavo Costa</h1>
  <p>{t('about.subtitle')}</p>
</section>
<section class="reading-bio">
  <div class="reading-prose">
    <p>{t('about.bio.p1')}</p>
    <p>{t('about.bio.p2')}</p>
    <p>{t('about.bio.p3')}</p>
  </div>
  <aside class="reading-links" aria-labelledby="links-title">
    <h2 id="links-title">{t('about.links.heading')}</h2>
    {links.map(link => <a href={link.href} target="_blank" rel="noopener noreferrer"><span>{link.label}</span><ArrowUpRight size={20} stroke-width={1.5} aria-hidden="true" /></a>)}
  </aside>
</section>
<section class="reading-history">
  <div>
    <h2>{t('about.education.heading')}</h2>
    <div class="history-entries">
      {education.map(item => <article><h3>{item.title}</h3><p>{item.place}</p></article>)}
    </div>
  </div>
  <div>
    <h2>{t('about.experience.heading')}</h2>
    <div class="history-entries">
      {experience.map(key => <article><h3>{t(`about.experience.${key}.title`)}</h3><p>{t(`about.experience.${key}.details`)}</p><p class="history-date">{t(`about.experience.${key}.dates`)}</p></article>)}
    </div>
  </div>
</section>
