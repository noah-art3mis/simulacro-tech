---
import ContourFields from './ContourFields.astro';
import PaperForms from './PaperForms.astro';
interface Props { kind: 'ai' | 'data' | 'pipelines' | 'adapta' | 'lexgpt' | 'glasshouse' | 'molcajete' | 'hero'; collection?: 'contours'; }
const { kind, collection } = Astro.props;

---
<div class={`work-visual visual-${kind}`}>
  <svg viewBox="0 0 360 220" aria-hidden="true" focusable="false">
    {collection !== 'contours' && <g class="illustration-a">
    {kind === 'ai' && <>
      <g class="engraving-line">{Array.from({length: 18}, (_, i) => <ellipse cx="142" cy="110" rx={15+i*4.2} ry={80-i*2.8}/>)}</g>
      <g class="engraving-violet">{Array.from({length: 18}, (_, i) => <ellipse cx="218" cy="110" rx={15+i*4.2} ry={80-i*2.8}/>)}</g>
      <ellipse class="engraving-light" cx="180" cy="110" rx="20" ry="70"/>
    </>}
    {kind === 'data' && <>
      <g class="engraving-line">{Array.from({length: 17}, (_, i) => <path d={`M ${43+i*6} ${132-i*3} C ${5+i*9} ${57+i*2}, ${131+i*2} ${9+i*5}, ${193-i} ${41+i*3} S ${348-i*6} ${72+i*2}, ${315-i*5} ${134-i} S ${184-i} ${217-i*5}, ${132+i} ${177-i*3} S ${57+i*5} ${169-i*2}, ${43+i*6} ${132-i*3} Z`}/>)}</g>
      <path class="engraving-light" d="M61 123C32 73 135 24 190 50S329 80 306 130 187 192 142 167 79 154 61 123Z"/>
    </>}
    {kind === 'pipelines' && <>
      <g class="engraving-line">{Array.from({length: 14}, (_, i) => <path d={`M18 ${45+i*4}C100 ${45+i*4},100 ${172-i*4},180 ${172-i*4}S260 ${45+i*4},342 ${45+i*4}`}/>)}</g>
      <g class="engraving-violet">{Array.from({length: 14}, (_, i) => <path d={`M18 ${175-i*4}C100 ${175-i*4},100 ${48+i*4},180 ${48+i*4}S260 ${175-i*4},342 ${175-i*4}`}/>)}</g>
      <path class="engraving-light" d="M18 69C100 69 100 148 180 148S260 69 342 69"/>
    </>}
    {kind === 'adapta' && <>
      <g class="engraving-soft">{Array.from({length: 23}, (_, i) => <path d={`M23 ${22+i*8}C100 ${22+i*8},120 ${99+i},180 ${99+i}S260 ${22+i*8},337 ${22+i*8}`}/>)}</g>
      <g class="engraving-line">{Array.from({length: 11}, (_, i) => <path d={`M23 ${54+i*11}C100 ${54+i*11},120 ${103+i*1.2},180 ${103+i*1.2}S260 ${48+i*12},337 ${48+i*12}`}/>)}</g>
      <path class="engraving-light" d="M23 87C100 87 120 107 180 107S260 84 337 84"/>
      <path class="engraving-rule" d="M180 30v48M180 143v47"/>
    </>}
    {kind === 'lexgpt' && <>
      <g class="engraving-violet">{Array.from({length: 15}, (_, i) => <path d={`M${47+i*5} 191V${99+i*2}A${89-i*5} ${72-i*2} 0 0 1 ${225-i*5} ${99+i*2}V191`}/>)}</g>
      <g class="engraving-line">{Array.from({length: 15}, (_, i) => <path d={`M${135+i*5} 191V${99+i*2}A${89-i*5} ${72-i*2} 0 0 1 ${313-i*5} ${99+i*2}V191`}/>)}</g>
      <path class="engraving-light" d="M180 191V81A45 44 0 0 1 270 81V191"/>
      <path class="engraving-rule" d="M34 191H326"/>
    </>}
    {kind === 'glasshouse' && <>
      <defs><clipPath id="glasshouse-lens"><circle cx="180" cy="110" r="79"/></clipPath></defs>
      <g class="engraving-soft">{Array.from({length: 20}, (_, i) => <path d={`M${35+i*14} 23L${15+i*14} 197`}/>)}</g>
      <g clip-path="url(#glasshouse-lens)">
        <circle cx="180" cy="110" r="79" fill="#17151c" fill-opacity=".7"/>
        <g class="engraving-violet">{Array.from({length: 24}, (_, i) => <path d={`M63 ${20+i*8}L297 ${-26+i*8}`}/>)}</g>
        <g class="engraving-line">{Array.from({length: 20}, (_, i) => <path d={`M${35+i*14} 23Q${82+i*10} 110 ${15+i*14} 197`}/>)}</g>
      </g>
      <circle class="engraving-line" cx="180" cy="110" r="79"/>
      <circle class="engraving-light" cx="180" cy="110" r="85"/>
      <path class="engraving-rule" d="M180 13v12M180 195v12M83 110H71M277 110h12"/>
    </>}
    {kind === 'molcajete' && <>
      <g class="engraving-line">{Array.from({length: 22}, (_, i) => <path d={`M25 ${35+i*7}C80 ${110+i*2},105 ${-20+i*10},180 ${45+i*6}S280 ${220-i*6},335 ${40+i*7}`}/>)}</g>
      <path class="engraving-light" d="M25 105C80 130 105 80 180 105S280 160 335 110"/>
    </>}
    {kind === 'hero' && <>
      <g fill="none" stroke="#f6d59a" stroke-width=".4">{Array.from({length: 32}, (_, i) => <path d={`M-60 ${210-i*4}C125 ${275-i*6} 65 ${-70+i*6} 410 ${15+i*3}`}/>)}</g>
      <g fill="none" stroke="#bab0d2" stroke-width=".24" opacity=".8">{Array.from({length: 26}, (_, i) => <path d={`M${15+i*6} -30C${-80+i*10} 130 ${400-i*7} 45 ${285-i*3} 240`}/>)}</g>
    </>}
    </g>}
    <g class={collection === 'contours' ? undefined : 'illustration-b'}><ContourFields kind={kind} /></g>
    {collection !== 'contours' && <g class="illustration-c"><PaperForms kind={kind} /></g>}
  </svg>
</div>
<script>
  const visuals = document.querySelectorAll<HTMLElement>('.project .work-visual, .project-detail .work-visual');
  visuals.forEach(visual => {
    const lines = visual.querySelectorAll<SVGGeometryElement>('path, ellipse, circle, rect, line, polyline, polygon');
    lines.forEach((line, index) => {
      if (line.closest('defs') || line.classList.contains('engraving-light') || getComputedStyle(line).stroke === 'none') return;
      line.setAttribute('pathLength', '1');
      line.classList.add('ink-line');
      line.style.setProperty('--ink-delay', `${(index % 6) * 35}ms`);
    });
  });
  const observer = new IntersectionObserver(entries => {
    for (const entry of entries) {
      entry.target.classList.toggle('visual-visible', entry.isIntersecting);
      if (entry.isIntersecting) entry.target.classList.add('ink-arrived');
    }
  }, { threshold: .15 });
  visuals.forEach(visual => observer.observe(visual));
  const reflectVisibility = () => document.documentElement.toggleAttribute('data-page-hidden', document.hidden);
  document.addEventListener('visibilitychange', reflectVisibility);
  reflectVisibility();
</script>
