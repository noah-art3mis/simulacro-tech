---
// Throwaway homepage refinements: same content, four directions; selection pending.
import { ArrowRight, ArrowLeft } from 'lucide-astro';
import Navigation from '../Navigation.astro';
import Footer from '../Footer.astro';
import WorkVisual from './WorkVisual.astro';
import { featuredProjects } from '../../data/featuredProjects';
import { ui } from '../../i18n/ui';
import '../../styles/global.css';
import './options.css';
import './atmosphere.css';
import './catalogue.css';
import './visuals.css';
import './motion.css';
const t = ui.en;
const variants = [
  { key: 'A', name: 'Atmosphere' },
  { key: 'B', name: 'Work first' },
  { key: 'C', name: 'Studio' },
  { key: 'D', name: 'Research catalogue' },
];
const services = ['ai', 'data', 'pipelines'] as const;
const disciplines = ['clinical', 'philosophy', 'technical'] as const;

---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Simulacro · Homepage prototype</title>
    <link rel="icon" href="/simulacro.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Crimson+Pro:wght@400;500;600&family=Space+Grotesk:wght@400;500;600&display=swap" rel="stylesheet" />
  </head>
  <body class="home-prototype" data-variant="A">
    <a class="skip-link" href="#content">Skip to content</a>
    <script is:inline define:vars={{ variants }}>
      const selected = new URLSearchParams(location.search).get('variant');
      const current = Math.max(0, variants.findIndex(option => option.key === selected));
      const option = variants[current];
      document.body.dataset.variant = option.key;
      document.title = `Simulacro · ${option.name} prototype`;
      document.addEventListener('DOMContentLoaded', () => {
        document.querySelector('.prototype-switcher strong').textContent = `${option.key} · ${option.name}`;
        document.querySelector('[data-cycle="previous"]').href = `?variant=${variants[(current + variants.length - 1) % variants.length].key}`;
        document.querySelector('[data-cycle="next"]').href = `?variant=${variants[(current + 1) % variants.length].key}`;
      });
      document.addEventListener('keydown', event => {
        if (event.target instanceof HTMLElement && event.target.closest('input, textarea, select, [contenteditable]')) return;
        if (event.altKey || event.ctrlKey || event.metaKey || event.shiftKey) return;
        const direction = { ArrowLeft: 'previous', ArrowRight: 'next' }[event.key];
        if (direction) document.querySelector(`[data-cycle="${direction}"]`)?.click();
      });
    </script>
    <canvas id="prototype-constellation" aria-hidden="true"></canvas>
    <Navigation lang="en" />
    <main id="content" class="option-page">
      <section class="intro">
        <h1>{t['home.hero.title.before']} <span>{t['home.hero.title.highlight']}</span></h1>
        <div class="intro-detail">
          <p>{t['home.hero.tagline']}</p>
          <a class="contact-link" href="#contact">{t['home.hero.cta']} <ArrowRight size={18} /></a>
        </div>
        <nav class="catalogue-index" aria-label="Areas of work">
          {services.map(service => <a href={`#service-${service}`}>{t[`home.services.${service}.title`]}<ArrowRight size={20} /></a>)}
        </nav>
      </section>
      <section class="services" aria-labelledby="services-heading">
        <div class="section-heading"><h2 id="services-heading">{t['home.services.heading']}</h2><p>{t['home.services.subheading']}</p></div>
        <div class="service-list">
          {services.map(service => <article id={`service-${service}`}>
            <h3>{t[`home.services.${service}.title`]}</h3>
            <WorkVisual kind={service} />
            <p>{t[`home.services.${service}.description`]}</p>
          </article>)}
        </div>
      </section>
      <section class="projects" aria-labelledby="projects-heading">
        <div class="section-heading"><h2 id="projects-heading">{t['home.projects.heading']}</h2><p>{t['home.projects.intro']}</p></div>
        <div class="project-list">
          {featuredProjects.map(project => <a class="project" href={`/projects#${project.id}`}>
            <WorkVisual kind={project.id} />
            <div class="project-copy"><h3>{project.name}</h3><p>{t[project.taglineKey]}</p></div>
            <ArrowRight size={22} aria-hidden="true" />
          </a>)}
        </div>
        <a class="text-link" href="/projects">{t['home.projects.cta']} <ArrowRight size={16} /></a>
      </section>
      <section class="background" aria-labelledby="background-heading">
        <div class="section-heading"><h2 id="background-heading">{t['home.why.heading']}</h2><p>{t['home.why.intro']}</p></div>
        <div class="discipline-list">
          {disciplines.map(discipline => <article><h3>{t[`home.why.${discipline}.title`]}</h3><p>{t[`home.why.${discipline}.description`]}</p></article>)}
        </div>
        <div class="bio"><p>{t['home.about.bio']}</p><a class="text-link" href="/about">{t['home.about.cta']} <ArrowRight size={16} /></a></div>
      </section>
      <section id="contact" class="contact" aria-labelledby="contact-heading">
        <div><h2 id="contact-heading">{t['home.contact.heading']}</h2><a class="text-link" href="mailto:contact@simulacro.tech">contact@simulacro.tech</a></div>
        <form onsubmit="event.preventDefault()">
          <p class="preview-note">Prototype form · messages are not sent.</p>
          <div class="form-pair">
            <label>{t['form.name.label']}<input autocomplete="name" placeholder={t['form.name.placeholder']} /></label>
            <label>{t['form.email.label']}<input type="email" autocomplete="email" placeholder={t['form.email.placeholder']} /></label>
          </div>
          <label>{t['form.message.label']}<textarea rows="5" placeholder={t['form.message.placeholder']}></textarea></label>
          <button type="button" disabled>{t['form.submit']}</button>
        </form>
      </section>
    </main>
    <Footer lang="en" />
    <aside class="prototype-switcher" aria-label="Design comparison">
      <a data-cycle="previous" href="?variant=D" aria-label="Previous option"><ArrowLeft size={18} /></a>
      <div><small>Homepage prototype</small><strong>A · Atmosphere</strong></div>
      <a data-cycle="next" href="?variant=B" aria-label="Next option"><ArrowRight size={18} /></a>
      <a class="baseline-link" href="https://simulacro.tech">Baseline</a>
    </aside>

    <script>
      import { startConstellation } from '../../scripts/constellation';
      if (document.body.dataset.variant === 'A') {
        startConstellation(document.querySelector<HTMLCanvasElement>('#prototype-constellation')!);
        const textObserver = new IntersectionObserver(entries => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.classList.add('text-arrived');
              textObserver.unobserve(entry.target);
            }
          }
        }, { threshold: .15 });
        document.querySelectorAll('.section-heading, .service-list h3, .service-list p, .project-copy, .discipline-list article, .bio, .contact > div, .contact form').forEach(element => textObserver.observe(element));
      }
    </script>
  </body>
</html>
