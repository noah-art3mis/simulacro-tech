---
import '../styles/site/projects-reading.css';
import {
	ArrowUpRight,
	Github,
} from 'lucide-astro';
import WorkVisual from './illustrations/WorkVisual.astro';
import { featuredProjects } from '../data/featuredProjects';
import { ui, type Lang, type UIKey } from '../i18n/ui';

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const t = (key: UIKey) => ui[lang][key];

type ProjectEntry = {
	href?: string;
	taglineKey: UIKey;
	descriptionKey: UIKey;
	id: string;
	name: string;
	statValues: readonly string[];
};
type OpenSourceEntry = {
	kind: 'openSource';
	id: string;
	name: string;
	href: string;
	repo: string;
	statValues: readonly string[];
};

const projectVisuals = {
  adapta: { kind: 'adapta' },
  lexgpt: { kind: 'lexgpt' },
  glasshouse: { kind: 'glasshouse' },
  molcajete: { kind: 'molcajete' },
  nopalero: { kind: 'data', collection: 'contours' },
  azulejo: { kind: 'glasshouse', collection: 'contours' },
  judex: { kind: 'lexgpt', collection: 'contours' },
  zelador: { kind: 'pipelines', collection: 'contours' },
} as const;

const systems: readonly ProjectEntry[] = [
	...featuredProjects,

	{
		id: 'nopalero',
		taglineKey: 'projects.production.nopalero.tagline',
		descriptionKey: 'projects.production.nopalero.description',
		name: 'Nopalero',
		statValues: ['48', '0'],
	},
	{
		id: 'azulejo',
		taglineKey: 'projects.production.azulejo.tagline',
		descriptionKey: 'projects.production.azulejo.description',
		name: 'Azulejo',
		statValues: ['94', '<5 s'],
	},
] as const;

const openSource: readonly OpenSourceEntry[] = [
	{
		kind: 'openSource',
		id: 'judex',
		name: 'Judex',
		href: 'https://github.com/noah-art3mis/judex-mini',
		repo: 'noah-art3mis/judex-mini',
		statValues: ['R$ 52', '0.93/s', '0.28/s', '4'],
	},
	{
		kind: 'openSource',
		id: 'zelador',
		name: 'Zelador',
		href: 'https://github.com/noah-art3mis/zelador',
		repo: 'noah-art3mis/zelador',
		statValues: [],
	},
] as const;
---

<section class="projects-intro">
  <div class="projects-intro-copy">
    <h1>{t('projects.intro.heading')}</h1>
    <p>{t('meta.projects.description')}</p>
  </div>
  <div class="projects-intro-art" aria-hidden="true"><WorkVisual kind="hero" /></div>
</section>

<section class="projects-section" aria-labelledby="systems-title">
  <h2 id="systems-title">{t('projects.section.systems')}</h2>
  <div class="project-details">
    {systems.map(p => {
      return <article id={p.id} class="project-detail">
        <div class="project-identity">
          <h3>{p.name}</h3>
          <WorkVisual {...projectVisuals[p.id as keyof typeof projectVisuals]} />
        </div>
        <div class="project-description">
          <p class="project-tagline">{t(p.taglineKey)}</p>
          <p class="project-copy">{t(p.descriptionKey)}</p>
          {p.href && <a href={p.href} class="project-link">{t('projects.visit')} <ArrowUpRight size={20} stroke-width={1.5} aria-hidden="true" /></a>}
          {p.statValues.length > 0 && <dl class="project-stats">
            {p.statValues.map((value, idx) => <div><dt>{t(`projects.production.${p.id}.stat.${idx}` as UIKey)}</dt><dd>{value}</dd></div>)}
          </dl>}
        </div>
      </article>;
    })}
  </div>
</section>

<section class="projects-section" aria-labelledby="open-source-title">
  <h2 id="open-source-title">{t('projects.section.openSource')}</h2>
  <div class="project-details">
    {openSource.map(p => {
      return <article id={p.id} class="project-detail">
        <div class="project-identity">
          <h3>{p.name}</h3>
          <WorkVisual {...projectVisuals[p.id as keyof typeof projectVisuals]} />
          <a href={p.href} target="_blank" rel="noopener noreferrer" class="project-repository"><Github size={17} aria-hidden="true" /><span>{p.repo}</span><ArrowUpRight size={17} aria-hidden="true" /></a>
        </div>
        <div class="project-description">
          <p class="project-tagline">{t(`projects.openSource.${p.id}.tagline` as UIKey)}</p>
          <p class="project-copy">{t(`projects.openSource.${p.id}.description` as UIKey)}</p>
          {p.statValues.length > 0 && <dl class="project-stats">
            {p.statValues.map((value, idx) => <div><dt>{t(`projects.openSource.${p.id}.stat.${idx}` as UIKey)}</dt><dd>{value}</dd></div>)}
          </dl>}
        </div>
      </article>;
    })}
  </div>
</section>

<section class="projects-cta">
  <h2>{t('projects.cta.heading')}</h2>
  <p>{t('projects.cta.lede')}</p>
</section>
