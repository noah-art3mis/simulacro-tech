---
import { ArrowUpRight, Github } from 'lucide-astro';
import ProjectStats from './ProjectStats.astro';
import { production, openSource } from '../data/projects';
import { ui, type Lang, type UIKey } from '../i18n/ui';
import { getLocalizedPath } from '../i18n/utils';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = (key: UIKey) => ui[lang][key];
const homeHref = getLocalizedPath('/', lang);
const contactHref = homeHref.replace(/\/$/, '') + '/#contact';
---
<header class="page-heading shell">
  <h1>{t('projects.intro.heading')}</h1>
  <p>{t('meta.projects.description')}</p>
</header>
<section class="project-collection shell" aria-labelledby="production-heading">
  <h2 id="production-heading">{t('projects.section.production')}</h2>
  {production.map(project => (
    <article id={project.id} class="project-detail">
      <h3>{project.name}</h3>
      <div>
        <p class="project-lede">{t(('projects.production.' + project.id + '.tagline') as UIKey)}</p>
        <p class="project-description">{t(('projects.production.' + project.id + '.description') as UIKey)}</p>
        <ProjectStats project={project} lang={lang} />
      </div>
    </article>
  ))}
</section>
<section class="project-collection shell" aria-labelledby="open-source-heading">
  <h2 id="open-source-heading">{t('projects.section.openSource')}</h2>
  {openSource.map(project => (
    <article id={project.id} class="project-detail">
      <div>
        <h3>{project.name}</h3>
        <a href={project.href} class="text-link repository-link" target="_blank" rel="noopener noreferrer"><Github size={17} />{project.repo}<ArrowUpRight size={16} /></a>
      </div>
      <div>
        <p class="project-lede">{t(('projects.openSource.' + project.id + '.tagline') as UIKey)}</p>
        <p class="project-description">{t(('projects.openSource.' + project.id + '.description') as UIKey)}</p>
        <ProjectStats project={project} lang={lang} />
      </div>
    </article>
  ))}
</section>
<section class="project-contact shell">
  <h2>{t('projects.cta.heading')}</h2>
  <p>{t('projects.cta.lede')}</p>
  <a href={contactHref} class="btn-primary">{t('home.hero.cta')} <ArrowUpRight size={18} /></a>
</section>
