---
import { Menu, ArrowUpRight } from 'lucide-astro';
import LanguageSwitcher from './LanguageSwitcher.astro';
import { ui, type Lang, type UIKey } from '../i18n/ui';
import { getLocalizedPath } from '../i18n/utils';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = (key: UIKey) => ui[lang][key];
const homeHref = getLocalizedPath('/', lang);
const navItems = [
  { href: homeHref, label: t('nav.home') },
  { href: getLocalizedPath('/projects', lang), label: t('nav.projects') },
  { href: getLocalizedPath('/about', lang), label: t('nav.about') },
];
const contactHref = homeHref.replace(/\/$/, '') + '/#contact';
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
---
<header class="site-header shell">
  <a href={homeHref} class="wordmark" aria-label="Simulacro Tech">
    simulacro<span>.tech</span>
  </a>
  <nav class="desktop-navigation" aria-label={t('nav.menu')}>
    {navItems.map(item => (
      <a href={item.href} aria-current={(item.href.replace(/\/$/, '') || '/') === currentPath ? 'page' : undefined}>{item.label}</a>
    ))}
    <a class="nav-contact" href={contactHref}>{t('nav.contact')} <ArrowUpRight size={16} /></a>
    <LanguageSwitcher lang={lang} />
  </nav>
  <details class="mobile-navigation">
    <summary aria-label={t('nav.menu')}><Menu size={23} /><span>{t('nav.menu')}</span></summary>
    <nav aria-label={t('nav.menu')}>
      {navItems.map(item => (
        <a href={item.href} aria-current={(item.href.replace(/\/$/, '') || '/') === currentPath ? 'page' : undefined}>{item.label}</a>
      ))}
      <a href={contactHref}>{t('nav.contact')}</a>
      <LanguageSwitcher lang={lang} />
    </nav>
  </details>
</header>
